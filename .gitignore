# Scratch MC results written by runInJupyter test runs (resultsKey="temp")
resultsMC/*_temp.csv

# Full boundary-replay histories are reproducible from the external EP database.
analysis/energyplus_replay/*/timeseries.csv.gz

# Reproducible per-surface histories for the free-running benchmark.
analysis/energyplus_free_running/*/surface_timeseries.csv.gz
analysis/energyplus_free_running/legacy_roughness_*/
analysis/energyplus_diagnosis/*/surface_timeseries.csv.gz
